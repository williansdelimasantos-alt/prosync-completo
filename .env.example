# =============================================================================
# ProSync - variaveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# Todos os valores abaixo tem defaults seguros para desenvolvimento local:
# sem nenhum .env o app sobe com SQLite e IA heuristica (sem chamadas externas).
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
# PRODUCTION=true ATIVA validacoes rigidas: com SECRET_KEY padrao (ou < 32 chars)
# ou CORS_ORIGINS=* a aplicacao NAO sobe e encerra com erro explicativo.
PRODUCTION=false

# --- Banco de dados ----------------------------------------------------------
# Desenvolvimento (default): SQLite em arquivo local.
# DATABASE_URL=sqlite:///./prosync.db
#
# Producao / docker-compose (Postgres):
#   postgresql://usuario:senha@host:5432/banco
# URLs no formato `postgres://` (Heroku/Railway) tambem sao aceitas e normalizadas.
DATABASE_URL=sqlite:///./prosync.db

# Pool de conexoes - usado apenas quando o banco NAO e SQLite.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Seguranca ---------------------------------------------------------------
# OBRIGATORIO em producao (PRODUCTION=true). Gere uma chave forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Com o valor padrao abaixo e PRODUCTION=true a app falha no startup (fail-fast).
SECRET_KEY=prosync-dev-secret-key-change-in-prod

# Validade do token JWT em minutos (default: 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS --------------------------------------------------------------------
# Lista separada por virgula. Em dev use * ; em prod liste os dominios do frontend.
# Em producao, CORS_ORIGINS=* e rejeitado no startup (fail-fast).
# Obs.: com `*` o `allow_credentials` e desligado automaticamente, pois
# navegadores recusam wildcard + credentials.
CORS_ORIGINS=*

# --- IA (Google Gemini) ------------------------------------------------------
# Sem chave, o app funciona com o motor heuristico e cache.
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=12

# false = nunca chama a IA (util em testes/CI/ambientes offline).
AI_ENABLED=true

# --- Credenciais usadas apenas pelo docker-compose.yml ------------------------
POSTGRES_USER=prosync
POSTGRES_PASSWORD=prosync
POSTGRES_DB=prosync
